# ═══════════════════════════════════════════
# Payment Module — Environment Variables
# Copy ไปที่ .env แล้วใส่ค่าจริง
# ═══════════════════════════════════════════

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Server ──
PORT=8122

# ── Database ──
DB_PATH=./data/payment.db

# ── ERP MCP ──
ERP_MCP_URL=http://localhost:18789

# ── WPilot Engine ──
WPILOT_API_URL=http://localhost:8118/api/wpilot

# ── Admin ──
ADMIN_API_KEY=bos_payment_admin_2026

# ── Notifications (optional) ──
LINE_NOTIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── PromptPay (Thai QR) ──
PROMPTPAY_NUMBER=0993946144
