# ─── AI Chat Support Service ──────────────────────
# Bridge between Chatwoot frontend and ERP MCP ai_chat

# Server
PORT=8108
NODE_ENV=development

# ─── ERP MCP Integration ──────────────────────────
# The ERP MCP runs as an OpenClaw stdio MCP server.
# The bridge supports two backends:
#   1. REST proxy: calls erp-core HTTP /mcp endpoint (if MODE=both or MODE=http)
#   2. MCP client: connects to OpenClaw MCP SSE endpoint
ERP_MCP_MODE=http
# erp-core HTTP server (port 3000 when MODE=http or MODE=both)
# ERP_MCP_URL=http://localhost:3000
ERP_MCP_URL=http://localhost:3000

# OpenClaw Gateway (port 18789) — used when ERP_MCP_MODE=mcp-sse
OPENCLAW_URL=http://localhost:18789

# ─── Chatwoot Integration ─────────────────────────
CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_KEY=

# ─── Defaults ─────────────────────────────────────
DEFAULT_TENANT_ID=t_001
DEFAULT_LANGUAGE=en
