# ─── Server ───────────────────────────────
PORT=8110
NODE_ENV=development

# ─── Fal.ai Image Generation ──────────────
FAL_KEY=fal-xxx-your-fal-ai-key
# Default Fal.ai model tier: fast | quality | pro
FAL_DEFAULT_MODEL=fast
# Default upscale model: esrgan | clarity | seedvr
FAL_UPSCALE_MODEL=esrgan

# ─── Remove.bg (Background Removal) ───────
REMOVE_BG_API_KEY=your-remove-bg-key
# Alternative: use Fal.ai background removal
# FAL_BG_REMOVAL=true

# ─── ERP MCP Integration ──────────────────
ERP_MCP_URL=http://localhost:18789
ERP_TENANT_ID=default

# ─── Storage ──────────────────────────────
# Where generated images are stored (local or S3-compatible)
STORAGE_DIR=./storage/images
# Public URL base for serving images from storage
PUBLIC_URL_BASE=http://localhost:8110

# ─── Brand Manager ────────────────────────
BRAND_PROFILES_DIR=./data/brand-profiles
TEMPLATES_DIR=./data/templates
