# Video Generation Service — Environment Configuration
# Copy to .env and fill in your API keys

# Server
PORT=8116
PUBLIC_URL_BASE=http://localhost:8116
STORAGE_DIR=./storage/videos

# Database
DB_PATH=./data/video-jobs.db

# Video Provider API Keys
WAVESPEED_API_KEY=
MINIMAX_API_KEY=
PIKA_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
HEYGEN_API_KEY=

# LLM for script generation (DeepSeek default)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ERP MCP Integration (Business OS)
ERP_MCP_URL=http://localhost:3000/api/mcp
ERP_TENANT_ID=default
