PORT=8100

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=superapp_schema
PGUSER=superapp
PGPASSWORD=superapp

# ERP Core MCP
ERP_MCP_URL=http://localhost:18789
DEFAULT_TENANT_ID=default
ERP_MCP_TIMEOUT=8000

# Seed templates on first run (set true for fresh install)
SEED_TEMPLATES=true

# Debug
LOG_QUERIES=false
NODE_ENV=development
